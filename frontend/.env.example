# Copy to .env.local to override. Vite only exposes variables prefixed VITE_.

# Base URL of the Go backend. Leave it empty to use same-origin requests: they
# go through the Vite dev proxy in development, and to the Go server that also
# serves the frontend in Docker. Set it to call the backend directly; the
# backend allows the Vite dev origin through CORS.
#
# VITE_API_BASE_URL=http://localhost:8080
VITE_API_BASE_URL=
